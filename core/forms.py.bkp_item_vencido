def _normalizar_chave_fluxo(valor):
    texto = unicodedata.normalize('NFKD', str(valor or '')).encode('ascii', 'ignore').decode('ascii')
    texto = texto.replace('-', ' ').replace('/', ' ').replace('(', ' ').replace(')', ' ')
    return ' '.join(texto.strip().lower().split())


