                    agrp = normalizar_texto(row.get('AGRP'))
                    faixa_desconto = normalizar_texto(row.get('FAIXA_DESCONTO'))
                    al_cred_simp = normalizar_decimal(row.get('AL_CRED_SIMP'))
                    al_csll = normalizar_decimal(row.get('AL_CSLL'))
                    al_irpj = normalizar_decimal(row.get('AL_IRPJ'))

