        valor_unitario = _valor_unitario_item(item)

        try:
            quantidade_com_problema = Decimal(str(item.quantidade_com_problema or 0))
        except (InvalidOperation, TypeError, ValueError):
            quantidade_com_problema = Decimal('0')

        try:
            valor_total_problema = (valor_unitario or Decimal('0')) * quantidade_com_problema
        except (InvalidOperation, TypeError, ValueError):
            valor_total_problema = Decimal('0')

        item_dict = {
            'obj': item,
            'codigo_produto': getattr(item.item_nota_fiscal, 'codigo_produto', None) or '-',
            'descricao_item': _descricao_item_sac(item),
            'tipo_ocorrencia_nome': item.tipo_ocorrencia.nome if item.tipo_ocorrencia else '-',
            'identificador': item.tipo_rastreio or '-',
            'numero_rastreio': item.numero_rastreio or '-',
            'quantidade_nf': getattr(item.item_nota_fiscal, 'quantidade', None),
            'quantidade_com_problema': item.quantidade_com_problema,
            'valor_unitario': f"{Decimal(str(valor_unitario or 0)):,.2f}".replace(',', 'X').replace('.', ',').replace('X', '.'),
            'valor_total_problema': f"{Decimal(str(valor_total_problema or 0)):,.2f}".replace(',', 'X').replace('.', ',').replace('X', '.'),
            'observacao_item': (item.observacao_item or '').strip() or '-',
            'setor_nome': _setor_item_nome(item) or '-',
        }
        if _item_pertence_ao_setor(item, setor_contexto):
            itens_visiveis.append(item_dict)
        else:
            itens_outros_setores.append(item_dict)

    avisos_outros_setores = [
        f"Esse SAC possui outro item com a ocorrência {item['tipo_ocorrencia_nome']} a ser resolvido pelo setor {item['setor_nome']}."
        for item in itens_outros_setores
    ]

    # Regra de fallback: se não houver item do setor atual, exibe os itens do SAC para não ocultar informações.
    if not itens_visiveis and itens_outros_setores:
        itens_visiveis = itens_outros_setores

    return {
        'itens_visiveis': itens_visiveis,
        'itens_outros_setores': itens_outros_setores,
        'avisos_outros_setores': avisos_outros_setores,
        'total_visivel': len(itens_visiveis),
        'total_geral': len(itens),
    }


