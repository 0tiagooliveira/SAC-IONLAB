        'itens_sac__item_nota_fiscal',
        'itens_sac__tipo_ocorrencia',
        'historicos',
    ).order_by('-data_abertura', '-id')

    if termo_cliente:
        sacs = sacs.filter(
            Q(cliente__razao_social__icontains=termo_cliente) |
            Q(cliente__nome__icontains=termo_cliente)
