@login_required
@transaction.atomic
def analise_tecnica_sac(request, sac_id):
    sac = get_object_or_404(
        SAC.objects.select_related('empresa', 'cliente', 'nota_fiscal', 'status_atual', 'setor_atual'),
        id=sac_id
    )

    analise_existente = getattr(sac, 'analise_tecnica', None)
    status_orcamento_externo = status_eh_orcamento_externo(sac.status_atual)
    dados_orcamento_iniciais, pecas_iniciais = montar_orcamento_inicial(sac)

    if request.method == 'POST':
        acao_formulario = request.POST.get('acao_formulario', 'analise')

        if acao_formulario == 'orcamento_externo':
            if not status_orcamento_externo and not getattr(sac, 'orcamento_tecnico_externo', None):
                messages.error(request, 'Bloqueado: o orçamento técnico externo só pode ser preenchido quando o SAC estiver com status Orçamento Técnico Externo.')
                return redirect('analise_tecnica_sac', sac_id=sac.id)

            orcamento_form = OrcamentoTecnicoExternoForm(request.POST)
            pecas_formset = OrcamentoPecaFormSet(request.POST, prefix='pecas')
            form = AnaliseTecnicaSACForm()

            if orcamento_form.is_valid() and pecas_formset.is_valid():
                tecnico = orcamento_form.cleaned_data['tecnico_externo']
                precisa_peca = orcamento_form.cleaned_data['precisa_peca_reposicao'] == 'sim'
                quantidade_horas = orcamento_form.cleaned_data.get('quantidade_horas') or Decimal('0')
                valor_unitario_hora = orcamento_form.cleaned_data.get('valor_unitario_hora') or Decimal('0')
                valor_total_horas = quantidade_horas * valor_unitario_hora

                itens_validos = []
                valor_total_pecas = Decimal('0')
                for f in pecas_formset:
                    if not hasattr(f, 'cleaned_data'):
                        continue
                    if f.cleaned_data.get('DELETE'):
                        continue
                    peca = f.cleaned_data.get('peca')
                    quantidade = f.cleaned_data.get('quantidade') or Decimal('0')
                    if peca and quantidade:
                        valor_total = quantidade * (peca.valor_unitario or Decimal('0'))
                        valor_total_pecas += valor_total
                        itens_validos.append((peca, quantidade, valor_total))

                if precisa_peca and not itens_validos:
                    messages.error(request, 'Bloqueado: informe ao menos uma peça de reposição quando selecionar Sim.')
                else:
                    valor_total_geral = valor_total_pecas + valor_total_horas
                    orcamento, _ = OrcamentoTecnicoExterno.objects.update_or_create(
                        sac=sac,
                        defaults={
                            'tecnico_externo': tecnico,
                            'telefone': orcamento_form.cleaned_data.get('telefone') or '',
                            'whatsapp': orcamento_form.cleaned_data.get('whatsapp') or '',
                            'email': orcamento_form.cleaned_data.get('email') or '',
                            'cidade': orcamento_form.cleaned_data.get('cidade') or '',
                            'estado': orcamento_form.cleaned_data.get('estado') or '',
                            'precisa_peca_reposicao': precisa_peca,
                            'quantidade_horas': quantidade_horas,
                            'valor_unitario_hora': valor_unitario_hora,
                            'valor_total_horas': valor_total_horas,
                            'valor_total_pecas': valor_total_pecas,
                            'valor_total_geral': valor_total_geral,
                        }
                    )
                    orcamento.pecas.all().delete()
                    for peca, quantidade, valor_total in itens_validos:
                        OrcamentoTecnicoExternoPeca.objects.create(
                            orcamento=orcamento,
                            peca=peca,
                            referencia=peca.referencia,
                            descricao=peca.descricao,
                            quantidade=quantidade,
                            valor_unitario=peca.valor_unitario,
                            valor_total=valor_total,
                        )

                    status_diretoria = obter_status_por_nome('Aguardando Aprovação de Orçamento – Diretoria') or obter_status_por_nome('Aguardando Aprovação de Orçamento - Diretoria')
                    setor_diretoria = obter_setor_por_nome('Diretoria')

                    aplicar_transicao_sac(
                        sac=sac,
                        usuario=request.user,
                        setor_destino=setor_diretoria,
                        status_novo=status_diretoria,
                        observacao=montar_observacao_orcamento_externo(orcamento),
                        acao_executada_texto='Orçamento técnico externo registrado',
                    )

                    messages.success(request, f'Orçamento técnico externo do SAC {sac.numero} registrado com sucesso.')
                    return redirect('analise_tecnica_sac', sac_id=sac.id)
        else:
            form = AnaliseTecnicaSACForm(request.POST)
            orcamento_form = OrcamentoTecnicoExternoForm(initial=dados_orcamento_iniciais)
            pecas_formset = OrcamentoPecaFormSet(initial=pecas_iniciais, prefix='pecas')

            if form.is_valid():
                tratativa = form.cleaned_data['tratativa_problema']
                tipo_problema = form.cleaned_data.get('tipo_problema')
                proximo_status = form.cleaned_data['proximo_status']
                observacao = (form.cleaned_data.get('observacao_tecnica') or '').strip()

                nome_tratativa = (tratativa.nome or '').strip().lower() if tratativa else ''
                resolvido_remotamente = (
                    'resolvido' in nome_tratativa and
                    'remoto' in nome_tratativa and
                    'não' not in nome_tratativa and
                    'nao' not in nome_tratativa
                )
                if resolvido_remotamente:
                    proximo_status = obter_status_por_nome('Concluído') or obter_status_por_nome('Concluido') or proximo_status
                else:
                    if (proximo_status.nome or '').strip().lower() in ['concluído', 'concluido']:
                        messages.error(request, 'Bloqueado: quando o problema não for resolvido remotamente, o próximo status nunca pode ser Concluído.')
                        return redirect('analise_tecnica_sac', sac_id=sac.id)

                observacao_historico = montar_observacao_analise(
                    tratativa=tratativa,
                    tipo_problema=tipo_problema,
                    proximo_status=proximo_status,
                    observacao_tecnica=observacao,
                )

                repetido = SacHistorico.objects.filter(
                    sac=sac,
                    acao_executada='Análise técnica registrada',
                    observacao=observacao_historico,
                ).exists()

                if repetido:
                    messages.error(request, 'Bloqueado: essas mesmas informações já foram registradas anteriormente para este SAC.')
                    return redirect('analise_tecnica_sac', sac_id=sac.id)

                SacAnaliseTecnica.objects.update_or_create(
                    sac=sac,
                    defaults={
                        'tratativa_problema': tratativa,
                        'tipo_problema': tipo_problema,
                        'observacao_tecnica': observacao,
                        'proximo_status_sugerido': proximo_status,
                        'usuario_responsavel': request.user,
                        'data_analise': timezone.now(),
                    }
                )

                proxima_acao, proximo_setor = buscar_fluxo_dinamico(
                    sac.acao_em_espera,
                    sac.setor_atual,
                )

                acao_final = proxima_acao or sac.acao_em_espera
                setor_destino = proximo_setor or sac.setor_atual

                validar_transicao_basica(
                    sac,
                    status_novo=proximo_status,
                    acao_nova=acao_final,
                    setor_destino=setor_destino,
                )

                aplicar_transicao_sac(
                    sac=sac,
                    usuario=request.user,
                    acao_em_espera=acao_final,
                    setor_destino=setor_destino,
                    status_novo=proximo_status,
                    observacao=observacao_historico,
                    acao_executada_texto='Análise técnica registrada',
                )

                messages.success(request, f'Análise técnica do SAC {sac.numero} registrada com sucesso.')
                return redirect('analise_tecnica_sac', sac_id=sac.id)
    else:
        form = AnaliseTecnicaSACForm()
        orcamento_form = OrcamentoTecnicoExternoForm(initial=dados_orcamento_iniciais)
        pecas_formset = OrcamentoPecaFormSet(initial=pecas_iniciais, prefix='pecas')

    historicos_queryset = sac.historicos.select_related('usuario', 'status_anterior', 'status_novo', 'setor_destino')[:15]

    historicos = []
    for h in historicos_queryset:
        eh_analise_tecnica = ((h.acao_executada or '').strip().lower() == 'análise técnica registrada')
        campos = extrair_campos_observacao_analise(h.observacao) if eh_analise_tecnica else {}

        historicos.append({
            'id': h.id,
            'data_evento': h.data_evento,
            'acao_executada': h.acao_executada,
            'usuario': (h.usuario.get_full_name() or h.usuario.get_username()) if getattr(h, 'usuario', None) else '-',
            'status_anterior': h.status_anterior,
            'status_novo': h.status_novo,
            'setor_destino': h.setor_destino,
            'observacao': h.observacao,
            'eh_analise_tecnica': eh_analise_tecnica,
            'tratativa': campos.get('tratativa', '') if eh_analise_tecnica else '',
            'tipo_problema': campos.get('tipo_problema', '') if eh_analise_tecnica else '',
            'proximo_status_texto': campos.get('proximo_status', '') if eh_analise_tecnica else '',
            'observacoes_tecnicas': campos.get('observacoes_tecnicas', '') if eh_analise_tecnica else '',
        })

    pecas_catalogo = montar_opcoes_pecas()
    fluxo_alertas = diagnosticar_fluxo_inicial(sac, setor_contexto=getattr(sac, 'setor_atual', None), nome_tela='Análise Técnica')

    return render(
        request,
        'core/analise_tecnica_sac.html',
        {
            'sac': sac,
            'form': form,
            'analise_existente': analise_existente,
            'historicos': historicos,
            'orcamento_form': orcamento_form,
            'pecas_formset': pecas_formset,
            'mostrar_orcamento_externo': status_orcamento_externo or getattr(sac, 'orcamento_tecnico_externo', None),
            'pecas_catalogo': pecas_catalogo,
            'fluxo_alertas': fluxo_alertas,
        }
    )


@login_required
def buscar_serial_lote_sac(request):
    termo = (request.GET.get('serial_lote') or request.GET.get('q') or '').strip()
    empresa_id = (request.GET.get('empresa_id') or '').strip()

    if not termo:
        return JsonResponse({'ok': False, 'mensagem': 'Informe o Serial/Lote para busca.'}, status=400)

    rastreios = RastreioNotaItem.objects.filter(serial_lote__iexact=termo)
    if empresa_id:
        rastreios = rastreios.filter(empresa_id=empresa_id)

    rastreios = list(rastreios.order_by('id')[:10])

    if not rastreios:
        return JsonResponse({'ok': False, 'mensagem': 'Serial/Lote não encontrado na base.'}, status=404)

    candidatos = []
    vistos = set()
    for rastreio in rastreios:
        numero_nf = (rastreio.numero_nf or '').strip()
        codigo_produto = (rastreio.codigo_produto or '').strip()
        if not numero_nf or not codigo_produto:
            continue

        notas_qs = NotaFiscal.objects.filter(empresa_id=rastreio.empresa_id).filter(
            Q(numero_nf=numero_nf) | Q(numero=numero_nf)
        ).select_related('cliente', 'empresa').order_by('-data_emissao', '-id')

        for nota in notas_qs[:5]:
            item_nf = ItemNotaFiscal.objects.filter(
                nota_fiscal=nota,
                codigo_produto=codigo_produto,
            ).order_by('id').first()
            if not item_nf:
                continue
            chave = (nota.id, item_nf.id, (rastreio.serial_lote or '').strip().upper())
            if chave in vistos:
                continue
            vistos.add(chave)
            candidatos.append(_serial_lote_payload(item_nf, rastreio))

    if not candidatos:
        return JsonResponse({'ok': False, 'mensagem': 'Serial/Lote encontrado no rastreio, mas sem vínculo consistente com NF/item.'}, status=404)

    if len(candidatos) > 1:
        return JsonResponse({
            'ok': False,
            'multiplo': True,
            'mensagem': 'Foi encontrado mais de um resultado para este Serial/Lote. Refine a busca selecionando a empresa ou revise a base.',
            'resultados': candidatos,
        }, status=409)

    return JsonResponse({'ok': True, 'resultado': candidatos[0]})


