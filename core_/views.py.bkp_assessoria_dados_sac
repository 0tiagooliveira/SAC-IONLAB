def buscar_sac_em_andamento_por_item_serial(item_nf, numero_rastreio, sac_excluir_id=None):
    numero = (numero_rastreio or '').strip()
    if not item_nf or not numero:
        return None

    query = SACItem.objects.filter(
        item_nota_fiscal__codigo_produto=item_nf.codigo_produto,
        tipo_rastreio='SERIAL',
        numero_rastreio=numero,
    ).select_related('sac__usuario_abertura', 'sac__status_atual')

    if sac_excluir_id:
        query = query.exclude(sac_id=sac_excluir_id)

    for sac_item in query.order_by('-sac__data_abertura'):
        status_nome = _status_nome(sac_item.sac).lower()
        if status_nome not in ['concluído', 'concluido', 'encerrado']:
            return sac_item.sac

    return None


