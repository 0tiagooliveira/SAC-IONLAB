    if bruto in {'SIM', 'S', 'TRUE', '1'}:
        return 'SIM'
    return 'NAO'


def _normalizar_sim_nao(valor):
    bruto = '' if valor is None else str(valor).strip().upper()
    if bruto in {'SIM', 'S', 'TRUE', '1'}:
        return 'SIM'
    return 'NAO'


def _formatar_decimal_sem_zeros(valor):
    if valor in (None, ''):
        return ''
    try:
        decimal_valor = Decimal(str(valor))
    except (InvalidOperation, TypeError, ValueError):
        return str(valor)
    texto = format(decimal_valor.normalize(), 'f')
    if '.' in texto:
        texto = texto.rstrip('0').rstrip('.')
    return texto


def _quantidade_item_nf(item_nf):
    if not item_nf:
        return Decimal('0')
    for attr in ('quantidade', 'pr_qtd', 'qtde', 'qtd'):
        valor = getattr(item_nf, attr, None)
        if valor not in (None, ''):
            try:
                return Decimal(str(valor))
            except (InvalidOperation, TypeError, ValueError):
                continue
    return Decimal('0')


def _valor_total_item_nf(item_nf):
    if not item_nf:
        return Decimal('0')
    for attr in ('valor_total_item', 'pr_sbt', 'valor_total', 'total_item'):
        valor = getattr(item_nf, attr, None)
        if valor not in (None, ''):
            try:
                return Decimal(str(valor))
            except (InvalidOperation, TypeError, ValueError):
                continue
    return Decimal('0')


def _valor_unitario_item_nf(item_nf):
    if not item_nf:
        return Decimal('0')
    for attr in ('valor_unitario', 'preco_unitario', 'vlr_unitario', 'valor'):
        valor = getattr(item_nf, attr, None)
        if valor not in (None, ''):
            try:
                return Decimal(str(valor))
            except (InvalidOperation, TypeError, ValueError):
                continue
    quantidade = _quantidade_item_nf(item_nf)
    total = _valor_total_item_nf(item_nf)
    if quantidade and quantidade > 0:
        return total / quantidade
    return Decimal('0')


def _grupo_tabela_preco_por_referencia(referencia, fallback=''):
    referencia = (referencia or '').strip()
    if not referencia:
        return fallback or ''
    peca = PecaTabelaPreco.objects.filter(referencia__iexact=referencia, ativo=True).only('grupo').first()
    grupo = (peca.grupo or '').strip() if peca else ''
    return grupo or (fallback or '')


def proximo_numero_sac():
    from django.utils import timezone
    ano_atual = timezone.now().year
    ultimo = SAC.objects.filter(ano=ano_atual).order_by('-sequencia_ano').first()
    proximo = 1 if not ultimo else ultimo.sequencia_ano + 1
    return f'{proximo:03d}/{ano_atual}'


@login_required
@user_passes_test(lambda u: u.is_superuser)
def executar_correcao_banco(request):
    if request.method != 'POST':
        return redirect('importar')

    buffer = io.StringIO()

    try:
        call_command('corrigir_banco', stdout=buffer)
        messages.success(request, 'Correção automática do banco executada com sucesso.')
    except CommandError as e:
        messages.error(request, f'Erro ao corrigir o banco: {e}')

    saida = buffer.getvalue().strip()
    if saida:
        messages.info(request, saida)

    return redirect('importar')


@login_required
@transaction.atomic
def importar_notas_excel(request):
    resumo = None

    if request.method == 'POST':
        form = ImportarNotasExcelForm(request.POST, request.FILES)

        if form.is_valid():
            empresa = form.cleaned_data['empresa']
            arquivo = form.cleaned_data['arquivo']

            try:
                df = pd.read_excel(arquivo, engine='openpyxl')
            except (ValueError, OSError, ImportError, zipfile.BadZipFile) as e:
                messages.error(request, f'Erro ao ler o arquivo Excel: {e}')
                return render(request, 'core/importar.html', {'form': form, 'resumo': resumo})

            df.columns = [str(col).strip().upper() for col in df.columns]

            numeros_planilha = set()
            for _, row in df.iterrows():
                numero_planilha = normalizar_numero_nf(row.get('NF_NUM'))
                if numero_planilha:
                    numeros_planilha.add(numero_planilha)

            notas_existentes = set(
                NotaFiscal.objects.filter(
                    empresa=empresa,
                    numero_nf__in=numeros_planilha,
                ).values_list('numero_nf', flat=True)
            )

            notas_importadas = 0
            notas_ignoradas = 0
            clientes_criados = 0
            itens_criados = 0
            itens_atualizados = 0
            notas_sem_numero = 0
            linhas_ignoradas_erro = 0

            notas_cache = {}
            notas_ignoradas_cache = set()

            for _, row in df.iterrows():
                try:
                    codigo_cliente = normalizar_codigo_excel(row.get('ID_CL'))
                    nome_cliente = normalizar_texto(row.get('CL_NOM'))
                    uf_cliente = normalizar_texto(row.get('CL_UF'))
                    cl_cfin = normalizar_texto(row.get('CL_CFIN'))
                    cl_ult_ent_mpm = normalizar_texto(row.get('CL_ULT_ENT_MPM'))

                    numero_nf = normalizar_numero_nf(row.get('NF_NUM'))
                    serie_nf = normalizar_texto(row.get('NF_SER'))
                    data_emissao = normalizar_data_excel(row.get('NF_EMI'))
                    id_nf = normalizar_texto(row.get('ID_NF'))

                    vendedor_codigo = normalizar_codigo_excel(row.get('ID_VN'))
                    vendedor_nome = normalizar_texto(row.get('VN_NOM'))
                    atualizar_cadastro_vendedor(vendedor_codigo, vendedor_nome)

                    transportadora_codigo = normalizar_codigo_excel(row.get('ID_TR'))
                    transportadora_nome = normalizar_texto(row.get('TR_NOM'))

                    cfop = normalizar_texto(row.get('CFOP'))
                    cfop_descricao = normalizar_texto(row.get('CFOP_DES'))

                    id_prnf = normalizar_texto(row.get('ID_PRNF'))

                    pr_cod = normalizar_texto(row.get('PR_COD'))
                    pr_des = normalizar_texto(row.get('PR_DES'))
                    pr_qtd = normalizar_decimal(row.get('PR_QTD'))
                    pr_sbt = normalizar_decimal(row.get('PR_SBT'))

                    pr_cusn = normalizar_decimal(row.get('PR_CUSN'))
                    v_icms = normalizar_decimal(row.get('V_ICMS'))
                    v_pis = normalizar_decimal(row.get('V_PIS'))
                    v_cofins = normalizar_decimal(row.get('V_COFINS'))
                    v_irpj = normalizar_decimal(row.get('V_IRPJ'))
                    v_csll = normalizar_decimal(row.get('V_CSLL'))
                    v_est_ircs_ou_simples = normalizar_decimal(row.get('V_EST_IRCS__OU__SIMPLES'))
                    v_comissao = normalizar_decimal(row.get('V_COMISSAO'))
                    v_frete_ctr = normalizar_decimal(row.get('V_FRETE_CTR'))
                    v_frete_nf = normalizar_decimal(row.get('V_FRETE_NF'))
                    v_seguro = normalizar_decimal(row.get('V_SEGURO'))
                    v_outras = normalizar_decimal(row.get('V_OUTRAS'))
                    v_desconto = normalizar_decimal(row.get('V_DESCONTO'))
                    difal = normalizar_decimal(row.get('DIFAL'))
                    fcp = normalizar_decimal(row.get('FCP'))
                    iss = normalizar_decimal(row.get('ISS'))
                    lucro_reais = normalizar_decimal(row.get('LUCRO_REAIS'))
                    lucro_percentual = normalizar_decimal(row.get('LUCRO_PERCENTUAL'))
                    v_ipi = normalizar_decimal(row.get('V_IPI'))
                    v_icmsst = normalizar_decimal(row.get('V_ICMSST'))
                    v_pisst = normalizar_decimal(row.get('V_PISST'))
                    v_cofinsst = normalizar_decimal(row.get('V_COFINSST'))
