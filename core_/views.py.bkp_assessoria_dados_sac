from django.contrib.auth import authenticate, login as auth_login, logout as auth_logout
from django.shortcuts import render, redirect

def _rota_inicial_por_setor_usuario(user):
    try:
        usuario_sistema = getattr(user, 'usuario_sistema', None)
        setor = getattr(usuario_sistema, 'setor', None)
        nome = ((getattr(setor, 'nome', '') or '').lower())
    except (AttributeError, TypeError, ValueError):
        nome = ''

    if 'comercial' in nome:
        return 'analise_comercial_sac_lista'
    if 'assessoria' in nome:
        return 'assessoria_cientifica'
    if 'diretoria' in nome:
        return 'analise_diretoria'
    if 'logistica' in nome or 'logística' in nome:
        return 'gestao_logistica_lista'
    if 'gestao' in nome:
        return 'gestao_sac'
    return 'painel_navegacao'


def login_interno(request):
    if request.user.is_authenticated:
        return redirect(_rota_inicial_por_setor_usuario(request.user))

    erro = None

    if request.method == 'POST':
        username = request.POST.get('username')
        password = request.POST.get('password')

        user = authenticate(request, username=username, password=password)

        if user:
            auth_login(request, user)
            return redirect(_rota_inicial_por_setor_usuario(user))

        erro = 'Usuário ou senha inválidos.'

    return render(request, 'core/login_interno.html', {'erro': erro})


def logout_interno(request):
    auth_logout(request)
    return redirect('login_interno')




