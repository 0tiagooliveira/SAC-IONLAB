def extrair_campos_observacao_analise(texto):
    campos = {
        'tratativa': '',
        'tipo_problema': '',
        'proximo_status': '',
        'observacoes_tecnicas': '',
    }
    if not texto:
        return campos

    mapeamento = {
        'tratativa do problema:': 'tratativa',
        'tipo de problema:': 'tipo_problema',
        'próximo status:': 'proximo_status',
        'proximo status:': 'proximo_status',
        'observações técnicas:': 'observacoes_tecnicas',
        'observacoes tecnicas:': 'observacoes_tecnicas',
    }

    for linha in str(texto).splitlines():
        linha_limpa = linha.strip()
        if not linha_limpa:
            continue
        chave_encontrada = None
        for prefixo, destino in mapeamento.items():
            if linha_limpa.lower().startswith(prefixo):
                chave_encontrada = (prefixo, destino)
                break
        if chave_encontrada:
            prefixo, destino = chave_encontrada
            campos[destino] = linha_limpa[len(prefixo):].strip(" :")
    return campos


