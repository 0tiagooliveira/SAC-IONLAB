def normalizar_texto(valor):
    if pd.isna(valor):
        return None
    valor = str(valor).strip()
    return valor if valor else None


def normalizar_codigo_excel(valor):
    texto = normalizar_texto(valor)
    if not texto:
        return None

    try:
        numero = float(texto.replace(',', '.'))
        if numero.is_integer():
            return str(int(numero))
    except (TypeError, ValueError):
        pass

    if texto.endswith('.0'):
        return texto[:-2]

    return texto



def atualizar_cadastro_vendedor(codigo, nome):
    codigo = normalizar_codigo_excel(codigo)
    nome = normalizar_texto(nome)

    if not codigo and not nome:
        return None

    nome_final = nome or codigo or ''
    codigo_final = codigo or nome_final

    vendedor = None
    if codigo_final:
        vendedor = Vendedor.objects.filter(codigo=codigo_final).first()

    if vendedor:
        alterou = False
        if nome_final and vendedor.nome != nome_final:
            vendedor.nome = nome_final
            alterou = True
        if getattr(vendedor, 'email', None) is None:
            vendedor.email = ''
            alterou = True
        if not getattr(vendedor, 'ativo', True):
            vendedor.ativo = True
            alterou = True
        if alterou:
            vendedor.save()
        return vendedor

    vendedor = Vendedor.objects.filter(nome=nome_final).first() if nome_final else None
    if vendedor:
        alterou = False
        if codigo_final and vendedor.codigo != codigo_final:
            vendedor.codigo = codigo_final
            alterou = True
        if getattr(vendedor, 'email', None) is None:
            vendedor.email = ''
            alterou = True
        if not getattr(vendedor, 'ativo', True):
            vendedor.ativo = True
            alterou = True
        if alterou:
            vendedor.save()
        return vendedor

    vendedor = Vendedor(
        codigo=codigo_final,
        nome=nome_final,
        ativo=True,
    )
    if hasattr(vendedor, 'email'):
        vendedor.email = ''
    vendedor.save()
    return vendedor


def normalizar_numero_nf(valor):
    if pd.isna(valor):
        return None
    try:
        texto = str(valor).strip()
        if not texto:
            return None
        return str(int(float(texto)))
    except (TypeError, ValueError):
        texto = str(valor).strip()
        return texto or None


def normalizar_data_excel(valor):
    if pd.isna(valor):
        return None
    try:
        data = pd.to_datetime(valor, errors='coerce')
        if pd.isna(data):
            return None
        return data.date()
    except (TypeError, ValueError):
        return None


def normalizar_decimal(valor, default='0'):
    if valor is None or pd.isna(valor):
        return Decimal(default)

    if isinstance(valor, Decimal):
        return valor

    if isinstance(valor, (int, float)):
        try:
            return Decimal(str(valor))
        except (InvalidOperation, TypeError, ValueError):
            return Decimal(default)

    texto = str(valor).strip()
    if not texto:
        return Decimal(default)

    texto = texto.replace('R$', '').replace(' ', '')

    if ',' in texto and '.' in texto:
        if texto.rfind(',') > texto.rfind('.'):
            texto = texto.replace('.', '')
            texto = texto.replace(',', '.')
        else:
            texto = texto.replace(',', '')
    elif ',' in texto:
        texto = texto.replace('.', '')
        texto = texto.replace(',', '.')

    try:
        return Decimal(texto)
    except (InvalidOperation, ValueError):
        return Decimal(default)


def dividir_saidas(texto):
    if not texto:
        return []
    bruto = str(texto).strip()
    if not bruto:
        return []
    partes = re.split(r'[,\;/\|\n\r]+', bruto)
    return [p.strip() for p in partes if p and p.strip()]


def _texto_nf(nota_fiscal):
    if not nota_fiscal:
        return ''
    numero = nota_fiscal.numero_nf or nota_fiscal.numero or ''
    data = nota_fiscal.data_emissao.strftime('%d/%m/%Y') if getattr(nota_fiscal, 'data_emissao', None) else ''
    return f'NF {numero} - {data}'.strip(' -')


def _serial_lote_payload(item_nf, rastreio):
    nota = item_nf.nota_fiscal if item_nf else None
    cliente = nota.cliente if nota else None
    quantidade = _quantidade_item_nf(item_nf)
    valor_unitario = _valor_unitario_item_nf(item_nf)

    return {
        'empresa_id': nota.empresa_id if nota else None,
        'cliente_id': cliente.id if cliente else None,
        'cliente_texto': f"{cliente.codigo_interno} - {cliente.razao_social or cliente.nome}" if cliente else '',
        'nota_fiscal_id': nota.id if nota else None,
        'nota_fiscal_texto': _texto_nf(nota),
        'item_id': item_nf.id if item_nf else None,
        'item_texto': item_nf.descricao_item or item_nf.item or '' if item_nf else '',
        'referencia': item_nf.codigo_produto or '' if item_nf else '',
        'grupo': (
            '' if not item_nf else (
                '' if getattr(item_nf, 'agrp', None) in (None, '', '-1', '-1.0', -1, -1.0)
                else str(getattr(item_nf, 'agrp', '')).strip()
            )
        ),
        'serial_lote_encontrado': rastreio.serial_lote or '',
        'tipo_rastreio': (rastreio.tipo or '').strip().upper(),
        'quantidade_total_nf': _formatar_decimal_sem_zeros(quantidade),
        'valor_unitario': float(valor_unitario or 0),
        'numero_nf': nota.numero_nf or nota.numero or '' if nota else '',
    }


def _normalizar_grupo_sac(valor, item_nf=None):
    bruto = '' if valor is None else str(valor).strip()
    invalidos = {'', '-1', '-1.0', 'NONE', 'NULL', 'NAN'}
    if bruto.upper() in invalidos:
        bruto = ''
    if not bruto and item_nf is not None:
        fallback = getattr(item_nf, 'agrp', None)
        bruto = '' if fallback is None else str(fallback).strip()
        if bruto.upper() in invalidos:
            bruto = ''
    return bruto or 'SEM GRUPO'


def _normalizar_item_quebrado_inservivel(valor):
