@transaction.atomic
def importar_rastreios_excel(request):
    resumo = None

    if request.method == 'POST':
        form = ImportarRastreiosExcelForm(request.POST, request.FILES)

        if form.is_valid():
            empresa = form.cleaned_data['empresa']
            arquivo = form.cleaned_data['arquivo']

            try:
                df = pd.read_excel(arquivo, engine='openpyxl')
            except (ValueError, OSError, ImportError, zipfile.BadZipFile) as e:
                messages.error(request, f'Erro ao ler o arquivo Excel: {e}')
                return render(request, 'core/importar_rastreios.html', {'form': form, 'resumo': resumo})

            df.columns = [str(col).strip().upper() for col in df.columns]

            numeros_planilha = set()
            for _, row in df.iterrows():
                num = normalizar_numero_nf(row.get('NUM'))
                if num:
                    numeros_planilha.add(num)

            notas_existentes = set(
                RastreioNotaItem.objects.filter(
                    empresa=empresa,
                    numero_nf__in=numeros_planilha
                ).values_list('numero_nf', flat=True)
            )

            notas_importadas = set()
            notas_ignoradas = set()
            registros_criados = 0
            linhas_sem_numero = 0

            for _, row in df.iterrows():
                numero_nf = normalizar_numero_nf(row.get('NUM'))

                if not numero_nf:
                    linhas_sem_numero += 1
                    continue

                if numero_nf in notas_existentes:
                    notas_ignoradas.add(numero_nf)
                    continue

                codigo_produto = normalizar_texto(row.get('CPR'))
                descricao_produto = normalizar_texto(row.get('DPR'))
                quantidade = normalizar_decimal(row.get('QUA'))
                tipo = normalizar_texto(row.get('TIP'))
                data_doc = normalizar_data_excel(row.get('DAT'))
                saidas_raw = normalizar_texto(row.get('SAIDAS'))

                saidas = dividir_saidas(saidas_raw)

                if not saidas:
                    RastreioNotaItem.objects.get_or_create(
                        empresa=empresa,
                        numero_nf=numero_nf,
                        codigo_produto=codigo_produto,
                        serial_lote='',
                        defaults={
                            'descricao_produto': descricao_produto,
                            'quantidade': quantidade,
                            'saidas_raw': saidas_raw,
                            'tipo': tipo,
                            'data_doc': data_doc,
                        }
                    )
                    registros_criados += 1
                else:
                    for serial_lote in saidas:
                        RastreioNotaItem.objects.get_or_create(
                            empresa=empresa,
                            numero_nf=numero_nf,
                            codigo_produto=codigo_produto,
                            serial_lote=serial_lote,
                            defaults={
                                'descricao_produto': descricao_produto,
                                'quantidade': quantidade,
                                'saidas_raw': saidas_raw,
                                'tipo': tipo,
                                'data_doc': data_doc,
                            }
                        )
                        registros_criados += 1

                notas_importadas.add(numero_nf)

            resumo = {
                'empresa': empresa.razao_social,
                'notas_importadas': len(notas_importadas),
                'notas_ignoradas': len(notas_ignoradas),
                'registros_criados': registros_criados,
                'linhas_sem_numero': linhas_sem_numero,
            }

            messages.success(request, 'Importação de serial/lote concluída com sucesso.')
            form = ImportarRastreiosExcelForm()
    else:
        form = ImportarRastreiosExcelForm()

    return render(request, 'core/importar_rastreios.html', {'form': form, 'resumo': resumo})


